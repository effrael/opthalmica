---
import FormularioWhatsapp from "../../shared/formulario/FormularioWhatsapp.astro";
---

<section id="contacto" class="relative isolate overflow-hidden bg-[#f7f7f9]" aria-labelledby="contact-title">
  <div class="relative z-1 grid lg:grid-cols-2">
    <div class="h-[420px] lg:sticky lg:top-[84px] lg:h-[calc(100vh-84px)] lg:min-h-[680px]">
      <img
        src="/images/foto_contacto.webp"
        alt="Personal de Opthalmica Visión atendiendo en recepción"
        width="1200"
        height="1200"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-[55%_30%]"
      />
    </div>

    <div class="flex min-h-[760px] items-center px-5 py-16 sm:px-10 lg:px-[clamp(48px,7vw,130px)] lg:py-24">
      <div class="mx-auto w-full max-w-[620px]">
        <h2
          id="contact-title"
          class="mb-12 text-[clamp(40px,4.8vw,72px)] leading-[1.02] font-medium tracking-[-0.05em] text-principal"
        >
          ¿Listo/a para<br /> cuidar tu visión?
        </h2>

        <FormularioWhatsapp />
      </div>
    </div>
  </div>
</section>
