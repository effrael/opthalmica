---
import { Award, Eye, HandHeart, Lightbulb, Microscope, Scale } from "@lucide/astro";
import MotivoCard from "./MotivoCard.astro";

const motivos = [
  {
    icono: HandHeart,
    titulo: "Atención realmente personalizada",
    texto: "Escuchamos, comprendemos tus dudas y explicamos con claridad las alternativas.",
  },
  {
    icono: Award,
    titulo: "Atención oftalmológica especializada",
    texto: "Evaluación orientada a un diagnóstico preciso y al tratamiento adecuado para cada paciente.",
  },
  {
    icono: Microscope,
    titulo: "Tecnología para un diagnóstico preciso",
    texto: "Equipamiento especializado que complementa la evaluación médica.",
  },
  {
    icono: Eye,
    titulo: "Atención integral en un mismo centro",
    texto: "Evaluación, estudios, tratamiento y seguimiento de manera coordinada.",
  },
  {
    icono: Scale,
    titulo: "Experiencia y seguridad",
    texto: "Experiencia clínica y quirúrgica junto con una evaluación cuidadosa y responsable.",
  },
  {
    icono: Lightbulb,
    titulo: "Acompañamiento durante todo el proceso",
    texto: "Seguimiento y resolución de dudas durante el tratamiento y la recuperación.",
  },
];
---

<section class="bg-[#f7f7f9] px-5 py-20 sm:px-10 md:py-28 lg:px-14">
  <div class="mx-auto max-w-[1280px]">
    <div class="mb-14 flex items-start gap-5 border-b border-slate-300 pb-8">
      <span class="text-sm font-semibold text-primary">02</span>
      <div>
        <p class="mb-3 text-xs font-semibold tracking-[0.14em] text-primary uppercase">Por qué elegirnos</p>
        <h2 class="text-[clamp(34px,4vw,56px)] leading-none font-semibold tracking-[-0.045em]">
          Cuidado visual en el que puedes confiar
        </h2>
      </div>
    </div>

    <div class="grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {motivos.map((motivo) => <MotivoCard {...motivo} />)}
    </div>
  </div>
</section>
