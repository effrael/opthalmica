---
const parrafos = [
  "En Opthalmica Vision entendemos que cada paciente es único y que detrás de cada problema visual existen dudas, inquietudes y necesidades diferentes.",
  "Por eso brindamos una atención cercana y personalizada, tomándonos el tiempo para escucharte, resolver tus dudas y acompañarte en cada etapa.",
  "Combinamos experiencia médica especializada y tecnología oftalmológica para ofrecerte un diagnóstico preciso y el tratamiento más adecuado para ti.",
];
---

<section class="px-5 py-20 sm:px-10 md:py-28 lg:px-14">
  <div class="mx-auto grid max-w-[1280px] items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-24">
    <img
      src="/images/nosotros.png"
      alt="Médico oftalmólogo de Opthalmica Visión junto a una lámpara de hendidura"
      width="1254"
      height="1254"
      loading="eager"
      class="h-[460px] w-full rounded-[24px] object-cover object-[68%_center] md:h-[580px]"
    />

    <div>
      <p class="mb-5 text-xs font-semibold tracking-[0.14em] text-primary uppercase">Nuestra propuesta de valor</p>
      <h2 class="text-[clamp(36px,4vw,58px)] leading-[1.04] font-semibold tracking-[-0.045em]">
        Cuidamos tu visión de una forma más cercana
      </h2>
      <div class="mt-8 space-y-6 text-base leading-8 text-slate-600">
        {parrafos.map((parrafo) => <p>{parrafo}</p>)}
      </div>
    </div>
  </div>
</section>
