---
import { CircleCheck } from "@lucide/astro";
import type { Servicio } from "../../data/servicios";

interface Props {
  servicio: Servicio;
}

const { servicio } = Astro.props;
---

<section class="px-6 py-20 sm:px-10 lg:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="text-sm font-semibold tracking-wider text-primary uppercase">Cuidado integral</p>
      <h2 class="mt-4 text-3xl leading-tight font-semibold tracking-tight sm:text-5xl">{servicio.tituloCuidado}</h2>
      <ul class="mt-8 space-y-5">
        {
          servicio.puntos.map((punto) => (
            <li class="flex items-start gap-3 leading-7 text-slate-600">
              <CircleCheck size={22} class="mt-0.5 shrink-0 text-secondary" aria-hidden="true" />
              <span>{punto}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <img
      src={servicio.imagen}
      alt=""
      width="1254"
      height="1254"
      loading="lazy"
      style={`object-position: ${servicio.enfoque}`}
      class="h-96 w-full rounded-2xl object-cover lg:h-[500px]"
    />
  </div>
</section>
