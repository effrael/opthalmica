---
import FormularioWhatsapp from "../shared/formulario/FormularioWhatsapp.astro";

interface Props {
  nombreServicio: string;
}

const { nombreServicio } = Astro.props;
---

<!-- Tarjeta flotante que se superpone al hero -->
<section
  id="contacto"
  aria-labelledby="contact-title"
  class="relative z-10 mx-auto -mt-16 w-[calc(100%-32px)] max-w-5xl overflow-hidden rounded-xl border border-slate-300 bg-white px-5 py-7 shadow-sm sm:px-10 lg:-mt-20"
>
  <div data-reveal class="mb-7 text-center">
    <h2 id="contact-title" class="text-xl font-semibold text-principal sm:text-2xl">
      Agenda una cita para <span class="text-primary">{nombreServicio}</span>
    </h2>
    <p class="mt-2 text-sm text-slate-600">Déjanos tus datos y te atenderemos por WhatsApp.</p>
  </div>

  <FormularioWhatsapp servicio={nombreServicio} />
</section>
