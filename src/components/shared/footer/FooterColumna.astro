---
// Columna de enlaces del footer (título + lista)
interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<nav data-reveal class="pt-16 md:pt-20" aria-label={titulo}>
  <h2 class="mb-7 text-base font-semibold text-principal">{titulo}</h2>
  <ul class="space-y-4">
    <slot />
  </ul>
</nav>
