---
import { MapPin } from "@lucide/astro";
import FooterColumna from "./FooterColumna.astro";
import Facebook from "../../../assets/icons/facebook.svg";
import Instagram from "../../../assets/icons/instagram.svg";
import Youtube from "../../../assets/icons/youtube.svg";
import { contacto, redes } from "../../../data/site";

const iconos = { facebook: Facebook, instagram: Instagram, youtube: Youtube };

const enlacesNosotros = [
  { label: "Quiénes somos", href: "/nosotros" },
  { label: "Servicios", href: "/servicios" },
  { label: "Contacto", href: "/#contacto" },
  { label: "Libro de Reclamaciones", href: "/libro-de-reclamaciones" },
];

const claseEnlace = "text-sm text-slate-600 transition-colors hover:text-primary";
const anio = new Date().getFullYear();
---

<footer class="bg-white px-5 pb-8 text-principal md:px-14">
  <div class="mx-auto max-w-[1280px] border-t border-slate-300">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.15fr_0.8fr_0.85fr_1.2fr] lg:gap-16">
      <!-- Logo y dirección -->
      <div data-reveal class="pt-10 md:pt-20">
        <a href="/" aria-label="Opthalmica Visión, inicio" class="inline-block">
          <img src="/logo.webp" alt="Opthalmica Visión" width="356" height="175" loading="lazy" class="h-auto w-[230px] object-contain" />
        </a>
        <address class="mt-6 flex max-w-[280px] items-start gap-3 text-sm leading-7 text-slate-600 not-italic">
          <MapPin size={19} class="mt-1 shrink-0 text-primary" aria-hidden="true" />
          <span>{contacto.direccion[0]}<br />{contacto.direccion[1]}</span>
        </address>
      </div>

      <FooterColumna titulo="Nosotros">
        {enlacesNosotros.map((enlace) => (
          <li><a class={claseEnlace} href={enlace.href}>{enlace.label}</a></li>
        ))}
      </FooterColumna>

      <FooterColumna titulo="Síguenos">
        {
          redes.map((red) => {
            const Icono = iconos[red.icono];
            return (
              <li>
                <a
                  class:list={[claseEnlace, "inline-flex items-center gap-3"]}
                  href={red.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icono width={18} height={18} aria-hidden="true" />
                  {red.nombre}
                </a>
              </li>
            );
          })
        }
      </FooterColumna>

      <!-- Tarjeta de ayuda -->
      <div data-reveal class="h-full w-full">
        <div class="flex h-full w-full flex-col bg-[rgb(245,247,250)] px-8 pt-16 pb-8 md:px-10 md:pt-20 md:pb-10">
          <h2 class="max-w-[260px] text-[clamp(27px,2.4vw,36px)] leading-[1.08] font-semibold tracking-[-0.035em]">
            Estamos para ayudarte
          </h2>
          <p class="mt-7 max-w-[260px] text-sm leading-6 text-slate-600">Accede al directorio de nuestras sedes</p>
          <a
            href="/#contacto"
            class="mt-7 inline-flex min-h-12 items-center justify-center rounded-full border-2 border-primary px-7 font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
          >
            Contáctanos
          </a>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <span>© {anio} Opthalmica Visión.</span>
      <span>Todos los derechos reservados.</span>
    </div>
  </div>
</footer>
