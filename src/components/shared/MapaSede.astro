---
import { contacto } from "../../data/site";

interface Props {
  /** Acercamiento del mapa (1–20). Por defecto usa el de src/data/site.ts */
  zoom?: number;
}

const { zoom = contacto.mapa.zoom } = Astro.props;

const parametros = new URLSearchParams({
  q: contacto.mapa.lugar,
  z: String(zoom),
  hl: "es",
  output: "embed",
});
const urlMapa = `https://maps.google.com/maps?${parametros}`;
---

<section aria-label="Ubicación de la sede en Google Maps" class="bg-[#f7f7f9]">
  <iframe data-reveal="fade"
    src={urlMapa}
    title={`Mapa: ${contacto.direccion.join(" ")}`}
    class="block h-[360px] w-full border-0 md:h-[450px]"
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</section>
