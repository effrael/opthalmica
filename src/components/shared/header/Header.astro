---
import { CalendarDays, Phone } from "@lucide/astro";
import NavLink from "./NavLink.astro";
import ServicesDropdown from "./ServicesDropdown.astro";
import MobileMenu from "./MobileMenu.astro";
import { contacto, navegacion } from "../../../data/site";
---

<header
  class="site-header fixed inset-x-0 top-0 z-50 h-[84px] bg-white transition-shadow duration-300 data-[scrolled=true]:shadow-[0_6px_24px_rgb(15_23_42/0.08)]"
  data-scrolled="false"
>
  <div class="grid h-full w-full grid-cols-[auto_1fr] items-center pl-[clamp(20px,4vw,72px)]">
    <a class="flex items-center" href="/" aria-label="Opthalmica Visión, inicio">
      <img
        src="/logo.webp"
        alt="Opthalmica Visión"
        width="356"
        height="175"
        fetchpriority="high"
        decoding="async"
        class="h-[70px] w-auto shrink-0 object-contain mix-blend-multiply"
      />
    </a>

    <div class="ml-auto flex h-full min-w-0 items-center justify-end">
      <nav
        class="flex items-center gap-6 px-[clamp(18px,3vw,52px)] text-base max-[950px]:hidden"
        aria-label="Navegación principal"
      >
        {
          navegacion.map((item) =>
            item.conSubmenu ? <ServicesDropdown /> : <NavLink href={item.href}>{item.label}</NavLink>
          )
        }
      </nav>

      <a
        href={contacto.telefonoHref}
        class="inline-flex h-[42px] w-[58px] shrink-0 items-center justify-center border-l border-slate-300 text-slate-800 transition-colors hover:text-primary max-[950px]:hidden"
        aria-label={`Llamar al ${contacto.telefono}`}
        title={contacto.telefono}
      >
        <Phone size={22} aria-hidden="true" />
      </a>

      <a
        href={contacto.whatsappCita}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-full shrink-0 items-center justify-center gap-3 bg-[#8bc418] px-[clamp(20px,2.5vw,44px)] text-sm font-semibold text-white transition-colors hover:bg-[#78aa14] max-[950px]:hidden"
        aria-label="Reservar una cita online por WhatsApp"
      >
        <CalendarDays size={22} aria-hidden="true" />
        Reserva tu cita online
      </a>

      <MobileMenu />
    </div>
  </div>
</header>

<script>
  // Añade sombra al header cuando se hace scroll
  const header = document.querySelector<HTMLElement>(".site-header");
  const actualizar = () => {
    if (header) header.dataset.scrolled = String(window.scrollY > 8);
  };
  actualizar();
  window.addEventListener("scroll", actualizar, { passive: true });
</script>
