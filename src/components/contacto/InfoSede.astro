---
import { Clock3, MapPin, Phone } from "@lucide/astro";
import { contacto } from "../../data/site";
---

<div class="mt-10 border-l border-slate-300 pl-7">
  <p class="text-sm text-slate-600">Sede</p>
  <h2 class="mt-1 text-2xl font-semibold text-principal">{contacto.sede}</h2>

  <ul class="mt-7 space-y-5 text-sm text-slate-700">
    <li class="flex items-start gap-3">
      <MapPin size={19} class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
      <span>{contacto.direccion.join(" ")}</span>
    </li>
    <li>
      <a href={contacto.telefonoHref} class="flex items-center gap-3 transition-colors hover:text-primary">
        <Phone size={19} class="shrink-0 text-primary" aria-hidden="true" />
        {contacto.telefono}
      </a>
    </li>
    <li class="flex items-start gap-3">
      <Clock3 size={19} class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
      <span>{contacto.horario[0]}<br />{contacto.horario[1]}</span>
    </li>
  </ul>
</div>
